# JANGAN commit file .env asli - gunakan .env.example sebagai template
# Isi kredensial di GitHub Secrets atau lokal

BASE_URL=https://eazy-academic.btpdev.my.id

# MODE SUPER ADMIN (Anda) - 1 akun akses semua role
SUPERADMIN_USERNAME=superadmin_demo
SUPERADMIN_PASSWORD=********

# Fallback jika pakai nama lama
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Opsional: jika ada captcha/OTP, isi manual token
CF_BYPASS=true
HEADLESS=false
